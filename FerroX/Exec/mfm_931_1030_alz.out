# ============================================================
# Main append block
# ============================================================

# 只有啟用 Excel 儲存與重複檢查時，才查詢既有 workbook。
already_in_excel = (
    SAVE_TO_EXCEL
    and SKIP_IF_FOLDER_EXISTS
    and folder_exists_in_excel(
        EXCEL_PATH,
        FOLDER_NAME,
        sheet_name=EXPERIMENTS_SHEET_NAME,
    )
)

if already_in_excel:
    print(
        f"[SKIP] {FOLDER_NAME} already exists "
        f"in the {EXPERIMENTS_SHEET_NAME!r} sheet."
    )

else:
    # --------------------------------------------------------
    # 1. Read parameters
    # --------------------------------------------------------
    inputs_path = CASE_DIR / INPUTS_FILENAME

    if not inputs_path.exists():
        raise FileNotFoundError(
            f"inputs not found: {inputs_path}"
        )

    # 使用你原本程式裡的 read_inputs()
    if "read_inputs" not in globals():
        raise NameError(
            "read_inputs() is not defined. "
            "Please run the inputs parsing cell first."
        )

    params_current = read_inputs(
        inputs_path,
    )

    # --------------------------------------------------------
    # 2. Read PV curve
    # --------------------------------------------------------
    pv_df_current = read_current_pv_curve(
        case_dir=CASE_DIR,
        folder_name=FOLDER_NAME,
    )

    # --------------------------------------------------------
    # 3. Extract and optionally save Pz/Phi
    # --------------------------------------------------------
    if SAVE_NPZ:
        pz_df_current = extract_current_pz_phi(
            case_dir=CASE_DIR,
            params=params_current,
            pv_df=pv_df_current,
            output_npz=NPZ_PATH,
        )
    else:
        pz_df_current = pd.DataFrame(columns=PZ_INDEX_COLUMNS)
        print("[SKIP] SAVE_NPZ=False; Pz/Phi extraction was skipped.")

    # --------------------------------------------------
    # 4. Calculate valid_loop
    # --------------------------------------------------
    csv_path = CASE_DIR / PV_CSV_RELATIVE_PATH

    if csv_path.is_file():
        print(f"Analyzing loop from CSV: {csv_path}")
        loop_analyzer = loop_metrics.LoopAnalyzer(
            open_threshold=OPEN_THRESHOLD,
            close_threshold=CLOSE_THRESHOLD,
        )
        loop_result = loop_analyzer.analyze_csv(csv_path)
        params_current["valid_loop"] = loop_result.valid_loop
    else:
        params_current["valid_loop"] = "no_data"

    # --------------------------------------------------
    # 5. Calculate has_multi
    # --------------------------------------------------
    npz_path = NPZ_PATH

    if SAVE_NPZ and npz_path.is_file():
        print(f"Analyzing multi-domain from NPZ: {npz_path}")
        multi_analyzer = has_multi.MultiAnalyzer(
            var_threshold=VAR_THRESHOLD,
            z_index=None,
        )
        multi_result = multi_analyzer.analyze_npz(npz_path)
        params_current["has_multi"] = multi_result.has_multi
    else:
        params_current["has_multi"] = "no_data"
    # --------------------------------------------------------
    # 6. Build experiments row
    # --------------------------------------------------------
    exp_df_current = build_experiment_dataframe(
        case_dir=CASE_DIR,
        params=params_current,
        pv_df=pv_df_current,
        pz_df=pz_df_current,
        npz_path=NPZ_PATH if SAVE_NPZ else None,
    )

    # --------------------------------------------------------
    # 7. Load or create Excel workbook
    # --------------------------------------------------------
    if SAVE_TO_EXCEL and EXCEL_PATH.exists():
        workbook = load_workbook(
            EXCEL_PATH
        )
    else:
        workbook = Workbook()

        # 移除 openpyxl 自動建立的 Sheet
        default_sheet = workbook.active
        workbook.remove(default_sheet)

    # --------------------------------------------------------
    # 8. Append all sheets in memory
    # --------------------------------------------------------
    append_dataframe_to_worksheet(
    workbook=workbook,
    sheet_name=EXPERIMENTS_SHEET_NAME,
    dataframe=exp_df_current,
    expected_columns=EXPERIMENT_COLUMNS,
    )

    append_dataframe_to_worksheet(
        workbook=workbook,
        sheet_name=PV_SHEET_NAME,
        dataframe=pv_df_current,
        expected_columns=PV_COLUMNS,
    )

    append_dataframe_to_worksheet(
        workbook=workbook,
        sheet_name=PZ_INDEX_SHEET_NAME,
        dataframe=pz_df_current,
        expected_columns=PZ_INDEX_COLUMNS,
    )

    # 最後只 save 一次，避免只寫完一個 sheet 就中斷。
    if SAVE_TO_EXCEL:
        EXCEL_PATH.parent.mkdir(parents=True, exist_ok=True)
        workbook.save(EXCEL_PATH)
        excel_status = str(EXCEL_PATH)
    else:
        excel_status = "not saved (SAVE_TO_EXCEL=False)"
        print("[SKIP] Excel workbook was not created or modified.")

    workbook.close()

    print("=" * 60)
    print("Analysis completed")
    print("Folder     :", FOLDER_NAME)
    print("Excel      :", excel_status)
    print("PV points  :", len(pv_df_current))
    print("Pz/Phi     :", len(pz_df_current))
    print("=" * 60)
